# ============================================================
# E-Quipped AI Mastery Platform — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017

# MongoDB database name
DB_NAME=equipped_ai

# JWT secret key — use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-secret-key

# Emergent LLM API key for AI sandbox features
EMERGENT_LLM_KEY=your-emergent-llm-key-here

# CORS allowed origins (comma-separated, no spaces)
# Example: https://yourdomain.com,https://www.yourdomain.com
# Use * only for development
CORS_ORIGINS=*
